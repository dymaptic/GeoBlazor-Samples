<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <!-- Same Pro version as the client. Referenced here as well as transitively so the Pro build validator
         runs against this project, which is where the browser host's license key lives. -->
    <PackageReference Include="dymaptic.GeoBlazor.Pro" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dispatch UI itself: Routes, the layout, the board, and the map all come from the client, so the
         browser host renders exactly what the server-hosted app does. -->
    <ProjectReference Include="..\SpatialDispatch.Client\SpatialDispatch.Client.csproj" />
    <ProjectReference Include="..\SpatialDispatch.Shared\SpatialDispatch.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than copied, so the browser host and the server-hosted app never drift apart. The map
         layers are the client's GeoJSON; the stylesheet and icon are the ones the server's App.razor links.
         ContentRoot names the folder the bytes actually live in. Without it the SDK records this project's
         wwwroot as the root, publish still copies the right file, but dotnet run looks for it here and
         serves an empty 200. -->
    <Content Include="..\SpatialDispatch.Client\wwwroot\data\*.geojson"
             Link="wwwroot\data\%(Filename)%(Extension)"
             ContentRoot="$(MSBuildProjectDirectory)\..\SpatialDispatch.Client\wwwroot\" />
    <Content Include="..\SpatialDispatch\wwwroot\app.css;..\SpatialDispatch\wwwroot\favicon.png"
             Link="wwwroot\%(Filename)%(Extension)"
             ContentRoot="$(MSBuildProjectDirectory)\..\SpatialDispatch\wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Pro key lives here for local runs only. A publish never carries it, so an uploaded folder cannot
         leak it; a deployed build supplies the key through appsettings.json instead. -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The client sets StaticWebAssetProjectMode=Default so the server can serve its _framework folder. A
       WebAssembly app that references it gets those same files as well as its own and fails the build with
       "Conflicting assets with the same target path". This host builds its own _framework, client assembly
       included, so it takes nothing from the client's static web assets and links the files it needs above. -->
  <Target Name="ExcludeClientStaticWebAssets" AfterTargets="ResolveReferencedProjectsStaticWebAssetsConfiguration">
    <ItemGroup>
      <StaticWebAssetProjectConfiguration Remove="@(StaticWebAssetProjectConfiguration)"
                                          Condition="'%(Filename)' == 'SpatialDispatch.Client'" />
    </ItemGroup>
  </Target>

</Project>

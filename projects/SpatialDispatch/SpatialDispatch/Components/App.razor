<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SpatialDispatch.styles.css"]" />
    <link rel="stylesheet" href="_content/dymaptic.GeoBlazor.Core/css/geoblazor.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    <Routes @rendermode="RenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Prerendering renders the page's content on the server so it is visible while the WebAssembly
    // bundle downloads and boots, which is several seconds on a cold load. The map is the one component
    // that cannot run twice, so see DispatchBoard for how it opts out of the prerender pass.
    private static readonly InteractiveWebAssemblyRenderMode RenderMode = new(prerender: true);
}

@page "/"
@using FleetDashboard.Client.Components
@using FleetDashboard.Client.Diagnostics
@using FleetDashboard.Client.Rendering
@using FleetDashboard.Client.State
@using FleetDashboard.Client.Streaming
@using FleetDashboard.Shared
@using Microsoft.Extensions.Configuration
@inject IFleetFrameSource FrameSource
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>Fleet dispatch · Pocono region</PageTitle>
<div class="dispatch-board">
    <header class="dispatch-header">
        <div><p class="eyebrow">Monroe County, Pennsylvania</p><h1>Fleet dispatch<span>.</span></h1></div>
        <div class="simulation-label">Simulated telemetry</div>
    </header>
    <div class="status-tape" role="status" aria-live="polite">
        <strong class="connection @(_mapError is null ? "" : "failure")">@ConnectionLabel</strong>
        <span>@_snapshot.Vehicles.Count vehicles</span>
        <span>@_snapshot.Vehicles.Count(v => v.Status == VehicleStatus.Moving) moving</span>
        <span>@_snapshot.Vehicles.Count(v => v.Status == VehicleStatus.Stale) stale</span>
        <span class="freshness">@FreshnessLabel</span>
    </div>
    @if (_mapError is not null)
    {
        <div class="error-banner" role="alert">
            <div><strong>Map updates paused</strong><p>@_mapError Telemetry remains available below.</p></div>
            <button @onclick="RetryMap">Retry map updates</button>
        </div>
    }
    @if (_sourceError is not null)
    {
        <div class="error-banner" role="alert">
            <div><strong>Telemetry unavailable</strong><p>@_sourceError</p></div>
            <button @onclick="RetryConnection">Retry connection</button>
        </div>
    }
    @if (_commandError is not null)
    {
        <div class="error-banner" role="alert">
            <div><strong>Scenario command failed</strong><p>@_commandError</p></div>
        </div>
    }
    @if (_mapRetryingAttempt > 0 && _mapError is null)
    {
        <p class="stale-message" role="status">
            Reapplying map updates after a failed batch (attempt @_mapRetryingAttempt of @FleetMap.MaxConsecutiveEditFailures).
        </p>
    }
    @if (_selectionNotice is not null)
    {
        <p class="stale-message" role="status">@_selectionNotice</p>
    }
    @if (_queue is { SafetyStop: true } queue)
    {
        <div class="error-banner" role="alert">
            <div><strong>Baseline safety stop</strong>
            <p>Pending reports reached @RawTelemetryQueue.Capacity.ToString("N0"), so the page stopped
               accepting new ones instead of growing without bound. Telemetry keeps flowing;
               @queue.RejectedRecordCount.ToString("N0") records were rejected.</p></div>
            <button @onclick="ResumeMapUpdates">Discard backlog and resume</button>
        </div>
    }
    <div class="workspace-grid">
        <section class="map-panel" aria-labelledby="map-title">
            <div class="map-heading"><h2 id="map-title">Pocono region</h2><span>4 local routes</span></div>
            <div class="map-surface">
                <FleetMap @key="_mapGeneration" Vehicles="_snapshot.Vehicles"
                          UpdatedVehicles="_mapUpdatedVehicles" RemovedVehicleIds="_mapRemovedVehicleIds"
                          UpdateBatchVersion="_mapBatchVersion"
                          EditGranularity="_mode.EditGranularity()"
                          MaxEditsPerDrain="@(_mode.UsesRawQueue() && _mode.EditGranularity() != MapEditGranularity.Ordered ? RawEditsPerDrain : 0)"
                          PendingReportsChanged="MapPendingReportsChanged" DiscardVersion="_discardVersion"
                          EditsApplied="RecordMapTelemetry" EditRetrying="MapRetrying"
                          SelectedVehicleId="_snapshot.SelectedVehicle?.VehicleId"
                          SelectedVehicleIdChanged="SelectVehicle" Initialized="MapInitialized"
                          EditFailed="MapFailed" SelectionFailed="SelectionFailed"
                          RetryVersion="_retryVersion" SimulateFailure="_simulateMapFailure"
                          ViewExtentChanged="ViewExtentChanged"
                          HostedLayerOptions="_hostedLayers" VisibleHostedLayers="_liveLayers" />
                @if (!_mapInitialized && _mapError is null)
                {
                    <div class="map-notice"><strong>Initializing map</strong><span>The vehicle list is ready to use.</span></div>
                }
                @if (_snapshot.HasCurrentSnapshot && _snapshot.Vehicles.Count == 0)
                {
                    <div class="map-notice"><strong>No vehicles to display</strong><span>Reset the scenario to restore the fleet.</span></div>
                }
            </div>
            <div class="map-legend" aria-label="Map symbol legend">
                <span><i class="marker moving" aria-hidden="true"></i> Live / moving</span>
                <span><i class="marker idle" aria-hidden="true"></i> Idle</span>
                <span><i class="marker stale" aria-hidden="true"></i> Stale</span>
                <span class="route-note">Stored road routes · not for navigation</span>
            </div>
        </section>
        <aside class="detail-rail" aria-label="Fleet roster and selected vehicle">
            <VehicleList Vehicles="_snapshot.Vehicles" SelectedVehicleId="_snapshot.SelectedVehicle?.VehicleId"
                         SelectedVehicleIdChanged="SelectVehicle" />
            <section class="selected-details" aria-labelledby="details-title">
                @if (_snapshot.SelectedVehicle is VehicleListItem selected)
                {
                    <div class="detail-heading">
                        <div><p class="eyebrow">Selected vehicle</p><h2 id="details-title">Truck @selected.VehicleId.ToString("D3")</h2></div>
                        <button class="clear-selection" @onclick="ClearSelection" aria-label="Clear vehicle selection">×</button>
                    </div>
                    <ol class="route-progress">
                        <li><span class="detail-label">Assigned route</span><strong>@selected.RouteName</strong></li>
                        <li class="@(selected.Status == VehicleStatus.Stale ? "is-stale" : "")">
                            <span class="detail-label">Current observation</span><strong>@selected.Status · @selected.SpeedKph.ToString("0.#") km/h</strong>
                            <span>Reported @selected.ObservedAtUtc.ToString("HH:mm:ss") UTC · @selected.AgeSeconds.ToString("0")s ago</span>
                            @if (selected.Status == VehicleStatus.Stale)
                            {
                                <p class="stale-message">Stale report. Showing the last-known position and speed.</p>
                            }
                        </li>
                        <li><SpeedChart Samples="_snapshot.SelectedHistory" LatestSpeedKph="selected.SpeedKph"
                                        WindowEndUtc="Clock.GetUtcNow()" /></li>
                    </ol>
                }
                else
                {
                    <p class="eyebrow">Selected vehicle</p><h2 id="details-title">Choose a truck</h2>
                    <p class="no-selection">Select a marker on the map or a vehicle in the list to see its route, latest report, and speed history. The map zooms to the truck you choose.</p>
                    <span class="selection-hint">Try truck 007 to follow the demo.</span>
                }
            </section>
        </aside>
    </div>
    <details class="scenario-controls">
        <summary>Display preview controls <span>Local server simulation</span></summary>
        <p class="eyebrow">
            Mode: @_mode.Label() · Load: @_preset.Name@(PresetStatusSuffix) ·
            Records/s: @Math.Round(_metrics.IncomingRecordsPerSecond) ·
            Vehicles/frame: @VehiclesPerFrameDisplay ·
            Pending: @PendingDisplay ·
            Map calls/s: @Math.Round(_metrics.MapCallsPerSecond, 1) ·
            Edit p50/p95: @FormatApplyDelay ·
            Failures: @_metrics.Failures ·
            Latest map batch: @_lastMapBatchCount ·
            Superseded state: @_state.SupersededPendingReportCount ·
            Reconnects: @ReconnectCountDisplay
        </p>
        @if (_modeNotice is not null)
        {
            <p class="stale-message">@_modeNotice</p>
        }
        <div class="preview-settings">
            <label for="preview-mode">Mode</label>
            <select id="preview-mode" @bind="_requestedMode">
                @foreach (DemoMode mode in Enum.GetValues<DemoMode>())
                {
                    <option value="@mode.Label()">@mode.Label()</option>
                }
            </select>
            <label for="preview-load">Load</label>
            <select id="preview-load" @bind="_requestedLoad">
                @foreach (ScenarioSettings preset in ScenarioSettings.All)
                {
                    <option value="@preset.Name">@preset.Name · @preset.VehicleCount.ToString("N0") vehicles × @preset.ReportsPerSecond/s = @preset.RecordsPerSecond.ToString("N0") records/s</option>
                }
            </select>
            <button class="apply-preview" @onclick="ApplyPreview">Apply and reload</button>
        </div>
        <div class="scenario-actions">
            <button @onclick="ToggleTruckPause" aria-pressed="@_pauseTruck.ToString().ToLowerInvariant()">@(_pauseTruck ? "Resume truck 007" : "Pause truck 007")</button>
            <button @onclick="ToggleFleetPause" aria-pressed="@_pauseFleet.ToString().ToLowerInvariant()">@(_pauseFleet ? "Resume all reports" : "Pause all reports")</button>
            <button @onclick="ShowEmptyFleet">Hide fleet locally</button>
            <button @onclick="SimulateMapError" disabled="@(_mapError is not null)">Simulate map failure</button>
            <button @onclick="BreakConnection" disabled="@(FrameSource is not IFleetScenarioControls)">Break connection</button>
            <button @onclick="ResetScenario">Reset scenario</button>
        </div>
        <LiveLayerControls Layers="_hostedLayers" Enabled="_liveLayers" LayerToggled="ToggleLiveLayer" />
    </details>
    <footer class="board-footer"><span>Local demonstration · seed 1190232</span><span>Positions and speeds are simulated.</span></footer>
</div>

@code {
    private const int RawCaptureLimit = 250;
    private const int RawEditsPerDrain = 250;
    private static readonly TimeSpan ViewportSettleDelay = TimeSpan.FromMilliseconds(300);

    protected override async Task OnInitializedAsync()
    {
        _mode = ParseMode();
        _preset = ParsePreset(_mode);
        _requestedMode = _mode.Label();
        _requestedLoad = _preset.Name;
        _metrics = new DemoMetrics(Clock);
        _hostedLayers = HostedLayers.Available(HostedLayers.HasApiKey(Configuration));
        if (_mode.UsesRawQueue()) _queue = new RawTelemetryQueue();
        _presetNeedsApply = FrameSource is IFleetScenarioControls;
        await Advance();
        _updateLoop = RunUpdates();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _lifetime.CancelAsync();
        if (_updateLoop is not null) await _updateLoop;
        _lifetime.Dispose();
    }

    private string ConnectionLabel => _mapError is not null ? "Map paused"
        : _sourceError is not null ? "Telemetry unavailable"
        : FrameSource is IFleetConnectionStatus { IsReconnecting: true } ? "Reconnecting"
        : !_mapInitialized ? "Initializing map"
        : _snapshot.Vehicles.Count == 0 ? "Empty fleet"
        : _snapshot.Vehicles.All(v => v.Status == VehicleStatus.Stale) ? "Stale telemetry"
        : _pauseFleet ? "Display held" : "Live";

    private string FreshnessLabel => _snapshot.LastFrameAtUtc is DateTimeOffset last
        ? $"Updated {Math.Max(0, (Clock.GetUtcNow() - last).TotalSeconds):0}s ago" : "Awaiting telemetry";

    private string PendingDisplay =>
        ((_queue?.PendingCount ?? _state.DirtyVehicleCount) + _mapPendingReports).ToString("N0");

    private void MapPendingReportsChanged(int count) => _mapPendingReports = count;

    /// <summary>Drops the raw queue and the map's ordered backlog together, so resuming never
    /// re-trips the safety stop on reports that were already abandoned.</summary>
    private void DiscardMapBacklog()
    {
        _queue?.Reset();
        _mapPendingReports = 0;
        _discardVersion++;
    }

    /// <summary>What the server sent in its latest frame, before the client merges it onto the
    /// roster. Full-roster modes show the whole fleet; viewport mode shows the drop.</summary>
    private string VehiclesPerFrameDisplay => FrameSource is IFleetViewportControls viewport
        ? viewport.LastReceivedVehicleCount.ToString("N0") : "n/a";

    private string ReconnectCountDisplay => FrameSource is IFleetConnectionStatus status
        ? status.ReconnectCount.ToString() : "n/a";

    /// <summary>Shown beside the requested preset until the hub confirms the change, so the
    /// controls never present a workload the server has not applied.</summary>
    private string PresetStatusSuffix => _presetNeedsApply ? " (applying)" : "";

    private string FormatApplyDelay
    {
        get
        {
            (double median, double p95) = _metrics.ApplyDurationMilliseconds;
            return $"{median:0.#} / {p95:0.#} ms";
        }
    }

    private async Task RunUpdates()
    {
        using var timer = new PeriodicTimer(_mode.MapCadence(), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                if (_disposed) break;
                await InvokeAsync(async () => { await Advance(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private DemoMode ParseMode()
    {
        string? value = QueryValue("mode");
        if (value is null) return DemoMode.Ready;
        if (DemoModeParser.TryParse(value, out DemoMode mode)) return mode;
        AddModeNotice($"Unknown mode '{value}' — running the ready dashboard.");
        return DemoMode.Ready;
    }

    /// <summary>Optional <c>preset</c> query override so every pipeline mode can be compared or
    /// rehearsed at the same workload. Without it, the mode's default preset applies and only
    /// <c>baseline</c> runs the stress load.</summary>
    private ScenarioSettings ParsePreset(DemoMode mode)
    {
        ScenarioSettings fallback = ScenarioSettings.ForMode(mode);
        string? value = QueryValue("preset");
        if (value is null) return fallback;
        if (ScenarioSettings.TryByName(value, out ScenarioSettings preset)) return preset;
        AddModeNotice($"Unknown preset '{value}' — using {fallback.Name}.");
        return fallback;
    }

    /// <summary>The mode fixes the client's queue and cadence at startup, so a new mode or load
    /// reloads the page through the same query string a rehearsed URL would use. The server
    /// simulator outlives the page, so a reload alone restarts only client state; resetting the
    /// server run first makes every comparison start from the same seed. A failed reset still
    /// reloads, because the reload is also how a presenter recovers from a dropped connection.</summary>
    private async Task ApplyPreview()
    {
        if (FrameSource is IFleetScenarioControls controls)
            await SendScenarioCommand(controls.ResetAsync());

        Navigation.NavigateTo($"?mode={_requestedMode}&preset={_requestedLoad}", forceLoad: true);
    }

    private string? QueryValue(string key) => new Uri(Navigation.Uri).Query.TrimStart('?')
        .Split('&', StringSplitOptions.RemoveEmptyEntries)
        .Select(pair => pair.Split('=', 2))
        .Where(parts => parts.Length == 2 && parts[0] == key)
        .Select(parts => Uri.UnescapeDataString(parts[1]))
        .FirstOrDefault();

    private void AddModeNotice(string notice) =>
        _modeNotice = _modeNotice is null ? notice : $"{_modeNotice} {notice}";

    private async Task Advance()
    {
        if (_disposed) return;

        DateTimeOffset now = Clock.GetUtcNow();
        try
        {
            bool serverScenario = FrameSource is IFleetScenarioControls;
            if (!_pauseFleet || serverScenario)
            {
                FleetFrame frame = await FrameSource.GetFrameAsync(now, _lifetime.Token);
                _lastFrame = frame;
                IReadOnlyList<VehicleReport> reports = _emptyFleet ? [] : frame.Vehicles;
                if (_pauseTruck && _heldTruck is not null)
                    reports = reports.Select(v => v.VehicleId == 7 ? _heldTruck : v).ToArray();
                frame = frame with { Vehicles = reports };

                _state.Accept(frame);

                // The frame source keeps serving its last known frame until a new one arrives, so
                // only an unseen frame is a new record; counting repeats would flood the raw queue
                // with duplicates and inflate the incoming-record metric.
                if (_frameCursor.TryAdvance(frame))
                {
                    // Baseline's queue measures the map falling behind, not map startup, so ordered
                    // intake waits until the map first reports ready. Nothing clears _mapInitialized, and
                    // RetryMap recreates the map only while it is still false, so the gate stays closed
                    // until a map initializes. Fleet state above still updates; other modes accept
                    // immediately.
                    if (_mapInitialized || _mode.EditGranularity() != MapEditGranularity.Ordered)
                        _queue?.Accept(frame, _mapPendingReports);
                    _metrics.RecordIncoming(ReceivedRecordCount(reports.Count));
                }

                _sourceError = null;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _sourceError = $"Telemetry unavailable: {exception.Message}";
        }

        await ApplyPresetIfPending();
        _snapshot = _state.CreateView(now);
        await SyncViewportIfPending(now);
        UpdateMapDelta(now);
    }

    /// <summary>A viewport frame is merged onto the roster before the page sees it, so count what
    /// actually arrived. Full frames arrive whole, so every other mode counts exactly as before.</summary>
    private int ReceivedRecordCount(int displayedCount) =>
        !_emptyFleet && _mode == DemoMode.Viewport && FrameSource is IFleetViewportControls viewport
            ? viewport.LastReceivedVehicleCount
            : displayedCount;

    private void ViewExtentChanged(ViewportExtent extent)
    {
        _viewExtent = extent;
        _viewExtentChangedAtUtc = Clock.GetUtcNow();
    }

    /// <summary>In viewport mode, tells the server what the map shows and which truck is selected.
    /// An extent is sent only once it has held still for <see cref="ViewportSettleDelay"/>, which
    /// debounces a pan or zoom animation on the update clock without a timer. Sends wait for a live
    /// connection, repeat after every reconnect (the server forgets a dropped connection), and a
    /// failed send simply stays pending for the next tick.</summary>
    private async Task SyncViewportIfPending(DateTimeOffset now)
    {
        if (_mode != DemoMode.Viewport || FrameSource is not IFleetViewportControls viewport) return;
        if (_lastFrame is null || _sourceError is not null) return;

        if (FrameSource is IFleetConnectionStatus status)
        {
            if (status.IsReconnecting) return;
            if (status.ReconnectCount != _viewportReconnectCount)
            {
                _viewportReconnectCount = status.ReconnectCount;
                _sentViewExtent = null;
                _selectionSent = false;
            }
        }

        try
        {
            if (_viewExtent is not null && _viewExtent != _sentViewExtent
                && now - _viewExtentChangedAtUtc >= ViewportSettleDelay)
            {
                ViewportExtent extent = _viewExtent;
                await viewport.SetViewportAsync(extent, _lifetime.Token);
                _sentViewExtent = extent;
            }

            int? selectedId = _snapshot.SelectedVehicle?.VehicleId;
            if (!_selectionSent || selectedId != _sentSelectedId)
            {
                await viewport.SetSelectedVehicleAsync(selectedId, _lifetime.Token);
                _sentSelectedId = selectedId;
                _selectionSent = true;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception)
        {
            // Left pending: the next update tick retries with the newest extent and selection.
        }
    }

    private void UpdateMapDelta(DateTimeOffset now)
    {
        if (_queue is not null)
        {
            PendingFleetBatch rawBatch = _queue.Capture(
                _mode.EditGranularity() == MapEditGranularity.Ordered ? int.MaxValue : RawCaptureLimit);
            // Roster removals are only tracked by the state model; the raw queue holds reports.
            PendingFleetBatch removedBatch = _state.CaptureDirty();
            _mapUpdatedVehicles = rawBatch.Reports
                .Select(report => VehicleListItems.Create(report, now)).ToArray();
            _mapRemovedVehicleIds = removedBatch.RemovedVehicleIds;
            _lastMapBatchCount = rawBatch.Reports.Count + _mapRemovedVehicleIds.Count;
        }
        else
        {
            PendingFleetBatch mapBatch = _state.CaptureDirty();
            _lastMapBatchCount = mapBatch.Reports.Count + mapBatch.RemovedVehicleIds.Count;
            Dictionary<int, VehicleListItem> vehicles = _snapshot.Vehicles.ToDictionary(vehicle => vehicle.VehicleId);
            _mapUpdatedVehicles = mapBatch.Reports
                .Where(report => vehicles.ContainsKey(report.VehicleId))
                .Select(report => vehicles[report.VehicleId])
                .ToArray();
            _mapRemovedVehicleIds = mapBatch.RemovedVehicleIds;
        }

        if (_lastMapBatchCount > 0) _mapBatchVersion++;
    }

    private void RecordMapTelemetry(MapEditTelemetry telemetry)
    {
        _mapRetryingAttempt = 0;
        _metrics.RecordMapCall(telemetry.FeatureCount, telemetry.ApplyMilliseconds);
    }

    private void MapRetrying(int attempt)
    {
        _metrics.RecordFailure();
        _mapRetryingAttempt = attempt;
    }

    private async Task RetryConnection()
    {
        if (FrameSource is IFleetConnectionStatus status)
        {
            await status.RetryConnectionAsync();
        }

        _sourceError = null;
        await Advance();
        StateHasChanged();
    }

    private async Task BreakConnection()
    {
        if (FrameSource is IFleetScenarioControls controls)
        {
            await controls.BreakConnectionAsync();
        }
    }

    private void SelectVehicle(int id)
    {
        _selectionNotice = null;
        _state.Select(id);
        _snapshot = _state.CreateView(Clock.GetUtcNow());
    }

    private void ClearSelection()
    {
        _state.Select(null);
        _snapshot = _state.CreateView(Clock.GetUtcNow());
    }

    private void SelectionFailed(string message)
    {
        _selectionNotice = message;
    }

    private void MapInitialized()
    {
        _mapInitialized = true;
    }

    private void MapFailed(string message)
    {
        _metrics.RecordFailure();
        _mapRetryingAttempt = 0;
        _mapError = message;
    }

    private void ResumeMapUpdates()
    {
        DiscardMapBacklog();
    }

    private void RetryMap()
    {
        _simulateMapFailure = false;
        _mapError = null;
        _mapRetryingAttempt = 0;
        _retryVersion++;
        if (!_mapInitialized)
        {
            _mapGeneration++;
            // The recreated map starts with an empty queue and may never report a count again.
            _mapPendingReports = 0;
        }
    }

    /// <summary>Hosted layers are shown or hidden on the map itself; nothing in the vehicle pipeline
    /// reads this set, so toggling never disturbs telemetry, selection, or the update loop.</summary>
    private void ToggleLiveLayer(string id)
    {
        HashSet<string> next = [.._liveLayers];
        if (!next.Remove(id)) next.Add(id);
        _liveLayers = next;
    }

    private async Task ToggleTruckPause()
    {
        if (FrameSource is IFleetScenarioControls controls)
        {
            bool pausing = !_pauseTruck;
            if (await SendScenarioCommand(pausing ? controls.PauseVehicleAsync(7) : controls.ResumeVehicleAsync(7)))
                _pauseTruck = pausing;
            return;
        }

        _pauseTruck = !_pauseTruck;
        _heldTruck = _pauseTruck ? _lastFrame?.Vehicles.FirstOrDefault(v => v.VehicleId == 7) : null;
    }

    private async Task ToggleFleetPause()
    {
        if (FrameSource is IFleetScenarioControls controls)
        {
            bool pausing = !_pauseFleet;
            if (await SendScenarioCommand(pausing ? controls.PauseFleetAsync() : controls.ResumeFleetAsync()))
                _pauseFleet = pausing;
            return;
        }

        _pauseFleet = !_pauseFleet;
    }

    private async Task<bool> SendScenarioCommand(Task command)
    {
        try
        {
            await command;
            _commandError = null;
            return true;
        }
        catch (Exception exception)
        {
            _commandError = $"Scenario command failed: {exception.Message}";
            return false;
        }
    }

    /// <summary>Re-sends the requested preset after the first successful frame and after every
    /// reconnect, so a preset survives a connection that was not ready at load time. A failed send
    /// stays pending and is reported as a command error, never as a frame-source error.</summary>
    private async Task ApplyPresetIfPending()
    {
        if (FrameSource is not IFleetScenarioControls controls) return;

        if (FrameSource is IFleetConnectionStatus status)
        {
            if (status.ReconnectCount != _seenReconnectCount)
            {
                _seenReconnectCount = status.ReconnectCount;
                _presetNeedsApply = true;
            }

            if (status.IsReconnecting) return;
        }

        if (!_presetNeedsApply || _sourceError is not null) return;

        if (await SendScenarioCommand(controls.SetPresetAsync(_preset.Name))) _presetNeedsApply = false;
    }

    private async Task ShowEmptyFleet()
    {
        _emptyFleet = true;
        _pauseFleet = false;
        await Advance();
    }

    private void SimulateMapError()
    {
        _simulateMapFailure = true;
    }

    private async Task ResetScenario()
    {
        if (FrameSource is IFleetScenarioControls controls)
            await SendScenarioCommand(controls.ResetAsync());

        _pauseTruck = false;
        _pauseFleet = false;
        _emptyFleet = false;
        _heldTruck = null;
        _state = new FleetDashboardState();
        DiscardMapBacklog();
        RetryMap();
        await Advance();
    }

    private IReadOnlyList<HostedLayerDefinition> _hostedLayers = [];
    private IReadOnlySet<string> _liveLayers = new HashSet<string>();
    private readonly CancellationTokenSource _lifetime = new();
    private readonly FleetFrameCursor _frameCursor = new();
    private FleetDashboardState _state = new();
    private FleetDashboardView _snapshot = new([], null, [], null, false);
    private FleetFrame? _lastFrame;
    private VehicleReport? _heldTruck;
    private Task? _updateLoop;
    private string? _mapError;
    private string? _sourceError;
    private string? _commandError;
    private string? _selectionNotice;
    private int _mapRetryingAttempt;
    private bool _mapInitialized;
    private bool _disposed;

<Project>
    <!-- Per-developer opt-in overrides (gitignored). Must come first: the conditions below read
         UseProjectReferences, and IDE project-model evaluation only sees it if set here. -->
    <Import Project="$(MSBuildThisFileDirectory)local.props"
            Condition="Exists('$(MSBuildThisFileDirectory)local.props')"/>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
        By default, samples reference the dymaptic.GeoBlazor NuGet package with Version="*" (latest).
        Set UseProjectReferences=true to build against the library source instead. This is the everyday dev
        loop when changing GeoBlazor and the samples together.

        GeoBlazorProjectPath defaults to the sibling checkout (GeoBlazor and GeoBlazor-Samples side by side
        in the same parent folder). Override it when the library lives elsewhere.

        Example usage:
          dotnet build /p:UseProjectReferences=true /p:GeoBlazorProjectPath=../GeoBlazor/src/dymaptic.GeoBlazor
    -->
    <PropertyGroup Condition="'$(UseProjectReferences)' == 'true'">
        <GeoBlazorProjectPath Condition="'$(GeoBlazorProjectPath)' == ''">$(MSBuildThisFileDirectory)..\GeoBlazor\src\dymaptic.GeoBlazor</GeoBlazorProjectPath>
        <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
        <!-- Source-ref sample hosts: drop the ESBuild-emitted GeoBlazor JS from the MapStaticAssets endpoint manifest so
             it isn't fingerprinted/listed; UseStaticFiles still serves it at its _content path. Matched against
             the served route, which for RCL assets is _content/{PackageId}/... . Retain the framework default. -->
        <StaticWebAssetEndpointExclusionPattern>
            $(StaticWebAssetEndpointExclusionPattern);_content/dymaptic.GeoBlazor/js/**
        </StaticWebAssetEndpointExclusionPattern>
    </PropertyGroup>
</Project>

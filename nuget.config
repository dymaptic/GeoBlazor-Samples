<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Pre-release dymaptic.GeoBlazor packages for validating the samples before they reach nuget.org.
             Pack the library into this folder, for example from the GeoBlazor repo:
               dotnet restore src/dymaptic.GeoBlazor/dymaptic.GeoBlazor.csproj
               dotnet pack src/dymaptic.GeoBlazor/dymaptic.GeoBlazor.csproj -c Release, no-restore, output to <this repo>/geoblazor_local
             The folder is tracked through a .gitkeep so restore works on a clean clone; its packages are gitignored. -->
        <add key="geoblazor_local" value="./geoblazor_local" />
    </packageSources>
</configuration>
